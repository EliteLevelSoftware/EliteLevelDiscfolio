<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EliteLevel.Disc.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://EliteLevel.Avalonia/Themes/EliteLevel.Theme.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="{StaticResource ElGold}"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://EliteLevel.Avalonia/Themes/Controls.axaml"/>
  </Application.Styles>
</Application>
