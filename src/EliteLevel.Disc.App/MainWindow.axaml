<controls:EliteWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:EliteLevel.Avalonia.Controls"
        xmlns:vm="using:EliteLevel.Disc.App.ViewModels"
        x:Class="EliteLevel.Disc.App.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainViewModel"
        Title="EliteLevel Discfolio"
        Classes.reduce="{Binding ReduceEffects}"
        DragDrop.AllowDrop="True"
        KeyDown="OnKeyDown">
  <controls:EliteWindow.DataContext>
    <vm:MainViewModel/>
  </controls:EliteWindow.DataContext>

  <Border Margin="{Binding ChromeMargin, RelativeSource={RelativeSource AncestorType=controls:EliteWindow}}"
          CornerRadius="{Binding ChromeRadius, RelativeSource={RelativeSource AncestorType=controls:EliteWindow}}"
          BoxShadow="{Binding ChromeShadow, RelativeSource={RelativeSource AncestorType=controls:EliteWindow}}"
          Background="{StaticResource ElCharcoal900Brush}"
          ClipToBounds="True">
    <Grid x:Name="Shell">
      <Grid ColumnDefinitions="220,*">
        <Grid x:Name="NavColumn" Grid.Column="0">
          <Border x:Name="Marker" Width="4" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Background="{StaticResource ElGoldBrush}" CornerRadius="0,4,4,0"
                  BoxShadow="{StaticResource ElShadowNavMarker}" IsHitTestVisible="False" ZIndex="2">
            <Border.RenderTransform>
              <TranslateTransform/>
            </Border.RenderTransform>
          </Border>
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="30,28,12,18">
              <controls:ProductMark Width="30" Height="30" VerticalAlignment="Center"/>
              <StackPanel VerticalAlignment="Center" Spacing="0">
                <TextBlock Text="Discfolio" FontSize="17" FontWeight="Bold" LetterSpacing="-0.17" Foreground="{StaticResource ElTextBrush}"/>
                <TextBlock Text="EliteLevel" FontSize="10.5" FontWeight="Medium" Foreground="{StaticResource ElTextMutedBrush}"/>
              </StackPanel>
            </StackPanel>
            <Border DockPanel.Dock="Bottom" Margin="16,8,16,20" Padding="14,12" CornerRadius="18"
                    Background="#1C1819" BorderBrush="{StaticResource ElBorderNavCardBrush}" BorderThickness="1">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="Open an image" FontSize="13" FontWeight="SemiBold"/>
                  <TextBlock Text="ISO, XISO, folder" FontSize="11.5" Foreground="{StaticResource ElTextMutedBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Width="30" Height="30" Classes="el-icon" Click="OnOpenFile" ToolTip.Tip="Open an image"
                        Background="{StaticResource ElCharcoal750Brush}">
                  <TextBlock Text="+" FontSize="18" Foreground="{StaticResource ElGoldBrush}" FontWeight="Bold"/>
                </Button>
              </Grid>
            </Border>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
              <Button x:Name="NavSettings" Classes="el-nav" Classes.active="{Binding IsSettings}" Command="{Binding ShowPageCommand}" CommandParameter="settings">
                <Grid ColumnDefinitions="22,*">
                  <Path StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" Width="20" Height="20" Stretch="Uniform"
                        Data="M12,8 a4,4 0 1 0 0.1,0 M12,2 v2 M12,20 v2 M4.9,4.9 l1.4,1.4 M17.7,17.7 l1.4,1.4 M2,12 h2 M20,12 h2 M4.9,19.1 l1.4,-1.4 M17.7,6.3 l1.4,-1.4"/>
                  <TextBlock Grid.Column="1" Text="Settings" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14.5"/>
                </Grid>
              </Button>
              <Button x:Name="NavHelp" Classes="el-nav" Classes.active="{Binding IsHelp}" Command="{Binding ShowPageCommand}" CommandParameter="help">
                <Grid ColumnDefinitions="22,*">
                  <Path StrokeThickness="1.7" StrokeLineCap="Round" Width="20" Height="20" Stretch="Uniform"
                        Data="M10,10 a4,4 0 1 1 4,4 v1 M12,18 h0.1"/>
                  <TextBlock Grid.Column="1" Text="Help" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14.5"/>
                </Grid>
              </Button>
            </StackPanel>
            <StackPanel Margin="0,4,0,0">
              <Button x:Name="NavLibrary" Classes="el-nav" Classes.active="{Binding IsLibrary}" Command="{Binding ShowPageCommand}" CommandParameter="library">
                <Grid ColumnDefinitions="22,*,Auto">
                  <Path StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" Width="20" Height="20" Stretch="Uniform"
                        Data="M4,4 H10 V20 H4 Z M12,4 H20 V20 H12 Z"/>
                  <TextBlock Grid.Column="1" Text="Library" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14.5"/>
                  <TextBlock Grid.Column="2" Classes="count" Text="{Binding LibraryCount}" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button x:Name="NavOpen" Classes="el-nav" Classes.active="{Binding IsOpenImages}" Command="{Binding ShowPageCommand}" CommandParameter="open">
                <Grid ColumnDefinitions="22,*,Auto">
                  <Path StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" Width="20" Height="20" Stretch="Uniform"
                        Data="M3,7 H9 L11,5 H21 V19 H3 Z"/>
                  <TextBlock Grid.Column="1" Text="Open images" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14.5"/>
                  <TextBlock Grid.Column="2" Classes="count" Text="{Binding OpenCount}" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button x:Name="NavExtract" Classes="el-nav" Classes.active="{Binding IsExtract}" Command="{Binding ShowPageCommand}" CommandParameter="extract">
                <Grid ColumnDefinitions="22,*,Auto">
                  <Path StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" Width="20" Height="20" Stretch="Uniform"
                        Data="M12,3 V15 M7,10 L12,15 L17,10 M4,19 H20"/>
                  <TextBlock Grid.Column="1" Text="Extract" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14.5"/>
                  <TextBlock Grid.Column="2" Classes="count" Text="{Binding ExtractCount}" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button x:Name="NavVerify" Classes="el-nav" Classes.active="{Binding IsVerify}" Command="{Binding ShowPageCommand}" CommandParameter="verify">
                <Grid ColumnDefinitions="22,*,Auto">
                  <Path StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" Width="20" Height="20" Stretch="Uniform"
                        Data="M12,3 L20,7 V13 C20,17 16,20 12,21 C8,20 4,17 4,13 V7 Z"/>
                  <TextBlock Grid.Column="1" Text="Verify" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14.5"/>
                  <TextBlock Grid.Column="2" Classes="count" Text="{Binding VerifyCount}" VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </StackPanel>
          </DockPanel>
        </Grid>

        <Grid Grid.Column="1" Margin="6,0,0,0" RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,18,150,0" PointerPressed="OnDrag" Background="Transparent">
            <Border Width="430" Height="44" CornerRadius="14" Background="{StaticResource ElCharcoal800Brush}">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0,10,0">
                <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource ElTextMutedBrush}" StrokeThickness="1.7" StrokeLineCap="Round"
                      Data="M10,10 a4.5,4.5 0 1 1 0.1,0 M14,14 L18,18" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" Classes="plain" Margin="12,0,8,0"
                         Watermark="Search images, files and title IDs" Text="{Binding SearchText}"/>
                <Border Grid.Column="2" Background="{StaticResource ElCharcoal750Brush}" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                  <TextBlock Text="Ctrl K" Classes="mono" FontSize="11" Foreground="{StaticResource ElTextFaintBrush}"/>
                </Border>
              </Grid>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Classes="el-icon" Command="{Binding ShowPageCommand}" CommandParameter="extract" ToolTip.Tip="Extract">
                <Path Width="18" Height="18" Stretch="Uniform" Stroke="#C9BDB7" StrokeThickness="1.7" StrokeLineCap="Round"
                      Data="M12,3 V15 M7,10 L12,15 L17,10 M4,19 H20"/>
              </Button>
              <Grid Width="44" Height="44">
                <Button Classes="el-icon" ToolTip.Tip="Notices">
                  <Path Width="18" Height="18" Stretch="Uniform" Stroke="#C9BDB7" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                        Data="M6,9 a6,6 0 0 1 12,0 c0,5 2,6 2,6 H4 s2,-1 2,-6 M10,19 a2,2 0 0 0 4,0"/>
                </Button>
                <Ellipse Width="7" Height="7" Fill="{StaticResource ElGoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                         IsVisible="{Binding HasNotification}" IsHitTestVisible="False"/>
              </Grid>
              <Border Height="44" CornerRadius="22" Background="{StaticResource ElCharcoal800Brush}" Padding="14,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Width="10" Height="10" Fill="{StaticResource ElSuccessBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="Read-only library" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource ElText2Brush}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" Margin="0,18,30,28">
            <Panel IsVisible="{Binding ShowEmpty}">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="420">
                <TextBlock Text="No image open" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Open a disc image or drop one here." Foreground="{StaticResource ElText2Brush}"
                           TextAlignment="Center" TextWrapping="Wrap"/>
                <Button Classes="el-primary" Content="Open image" HorizontalAlignment="Center" Click="OnOpenFile"/>
              </StackPanel>
            </Panel>

            <Panel IsVisible="{Binding IsLoading}">
              <Grid ColumnDefinitions="*,322" RowDefinitions="420,*">
                <Border Classes="skeleton" CornerRadius="26" Margin="0,0,20,0"/>
                <Border Grid.Column="1" Classes="skeleton" CornerRadius="24"/>
                <Border Grid.Row="1" Classes="skeleton" CornerRadius="20" Margin="0,22,20,0"/>
                <Border Grid.Row="1" Grid.Column="1" Classes="skeleton" CornerRadius="22" Margin="0,22,0,0"/>
              </Grid>
            </Panel>

            <Panel IsVisible="{Binding ShowError}">
              <Border Background="{StaticResource ElCharcoal850Brush}" CornerRadius="22" Padding="22" MaxWidth="560"
                      HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="{StaticResource ElDangerBrush}" BorderThickness="2,0,0,0">
                <StackPanel Spacing="12">
                  <TextBlock Text="{Binding ErrorMessage}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="Copy detail keeps the technical message off this sentence." Foreground="{StaticResource ElText2Brush}" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="el-primary" Content="Open image" Click="OnOpenFile"/>
                    <Button Classes="el-secondary" Content="Copy detail" Click="OnCopyDetail"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Panel>

            <Grid IsVisible="{Binding ShowBrowser}" RowDefinitions="420,*">
              <Grid ColumnDefinitions="*,322">
                <controls:HeroCard Margin="0,0,20,0"
                                   Seed="{Binding ArtSeed}" Icon="{Binding IconPath}" Banner="{Binding BannerPath}"
                                   Title="{Binding VolumeTitle}" Eyebrow="{Binding Eyebrow}"
                                   Chips="{Binding ChipLine}" Meta="{Binding MetaLine}"/>
                <controls:FeatureCard Grid.Column="1">
                  <DockPanel>
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*" Margin="0,16,0,0">
                      <Button Classes="el-primary" Content="Extract all" Command="{Binding BeginExtractAllCommand}"/>
                      <Button Grid.Column="1" Classes="el-ghost" Content="Verify" Margin="8,0,0,0" Command="{Binding VerifyCommand}"/>
                      <TextBlock Grid.Column="2" Text="{Binding PlatformTag}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 FontWeight="Bold" FontSize="12" Foreground="#FFF7EE"/>
                    </Grid>
                    <StackPanel>
                      <TextBlock Text="{Binding DetailTitle}" FontSize="22" FontWeight="Bold" Foreground="#FFF7EE"
                                 TextWrapping="Wrap" MaxLines="2" LineHeight="28" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding DetailTitle}"/>
                      <TextBlock Text="{Binding DetailSubtitle}" FontSize="12.5" Foreground="#C7FFF0E4" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding TitleId}" Classes="mono" FontSize="12.5" Foreground="#C7FFF0E4" Margin="0,4,0,14"
                                 IsVisible="{Binding HasTitleId}" TextTrimming="CharacterEllipsis"/>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Text="Size" FontSize="12.5" Foreground="#B8FFF0E4"/>
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold" Foreground="#FFF7EE"/>
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Text="SHA-256" FontSize="12.5" Foreground="#B8FFF0E4" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Background="Transparent" Padding="0" Click="OnCopyHash">
                          <TextBlock Classes="mono" Text="{Binding HashDisplay}" Foreground="#FFF3E2" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                        </Button>
                      </Grid>
                      <TextBlock Text="{Binding SourceName}" Classes="mono" FontSize="11" Foreground="#C7FFF0E4" TextTrimming="CharacterEllipsis"/>
                      <Button Classes="el-ghost" Content="Remove from library" HorizontalAlignment="Stretch" Margin="0,14,0,0"
                              Command="{Binding RemoveOpenFromLibraryCommand}"/>
                    </StackPanel>
                  </DockPanel>
                </controls:FeatureCard>
              </Grid>
              <Grid Grid.Row="1" Margin="0,22,0,0" ColumnDefinitions="*,372">
                <DockPanel Margin="0,0,20,0">
                  <Grid DockPanel.Dock="Top" Margin="0,0,0,12" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Recent images" FontSize="17" FontWeight="Bold"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                      <Button Background="Transparent" Command="{Binding ClearMissingCommand}">
                        <TextBlock Text="Clear missing" Foreground="{StaticResource ElText3Brush}" FontSize="13"/>
                      </Button>
                      <Button Background="Transparent" Command="{Binding ShowPageCommand}" CommandParameter="open">
                        <TextBlock Text="View library" Foreground="{StaticResource ElText3Brush}" FontSize="13"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="No recent images" Foreground="{StaticResource ElTextMutedBrush}"
                             IsVisible="{Binding !VisibleRecent.Count}"/>
                  <ItemsControl ItemsSource="{Binding VisibleRecent}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RecentItem">
                        <Button Classes="el-tile" Margin="0,0,12,0" MinHeight="220" Click="OnRecent" Tag="{Binding Path}" ToolTip.Tip="{Binding Title}">
                          <Button.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Remove from library" Click="OnRemoveFromLibrary"/>
                            </ContextMenu>
                          </Button.ContextMenu>
                          <controls:MediaTile Seed="{Binding Seed}" Icon="{Binding IconPath}" Title="{Binding Title}" Meta="{Binding Meta}"/>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>
                <Border Grid.Column="1" Background="{StaticResource ElCharcoal850Brush}" CornerRadius="22"
                        BorderBrush="{StaticResource ElBorderCardBrush}" BorderThickness="1" Padding="18,18,18,14">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                      <TextBlock Text="Files" FontSize="17" FontWeight="Bold"/>
                      <TextBlock Grid.Column="1" Classes="mono" FontSize="11" Foreground="{StaticResource ElTextMutedBrush}"
                                 Text="{Binding Locator}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Breadcrumb}" FontSize="12" Foreground="{StaticResource ElTextMutedBrush}"
                               Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                    <ListBox ItemsSource="{Binding Rows}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileRow">
                          <Button Classes="el-row" Classes.selected="{Binding IsSelected}" Click="OnRow" Tag="{Binding Path}"
                                  DoubleTapped="OnRowExpand">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="{Binding Indent}">
                              <Path Classes="file" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource ElText3Brush}"
                                    StrokeThickness="1.6" StrokeLineCap="Round" VerticalAlignment="Center"
                                    Data="M4,2 H10 L14,6 V18 H4 Z"/>
                              <TextBlock Grid.Column="1" Margin="8,0,8,0" Text="{Binding Name}" VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis" FontSize="13"/>
                              <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" FontSize="12"
                                         Foreground="{StaticResource ElTextMutedBrush}"/>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>
                </Border>
              </Grid>
            </Grid>

            <ScrollViewer IsVisible="{Binding IsOpenImages}">
              <StackPanel Spacing="16" MaxWidth="720">
                <TextBlock Text="Open images" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="One image is open at a time. Recent images stay on this machine." Foreground="{StaticResource ElText2Brush}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="el-primary" Content="Open image" Click="OnOpenFile"/>
                  <Button Classes="el-secondary" Content="Open folder" Click="OnOpenFolder"/>
                  <Button Classes="el-secondary" Content="Clear missing" Command="{Binding ClearMissingCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding LibraryMessage}" Foreground="{StaticResource ElTextMutedBrush}" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding VisibleRecent}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecentItem">
                      <Button Classes="el-row" HorizontalAlignment="Stretch" Click="OnRecent" Tag="{Binding Path}" Margin="0,4" ToolTip.Tip="{Binding Title}">
                        <Button.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Remove from library" Click="OnRemoveFromLibrary"/>
                          </ContextMenu>
                        </Button.ContextMenu>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Meta}" Foreground="{StaticResource ElTextMutedBrush}" Margin="16,0,0,0"/>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsExtract}">
              <StackPanel Spacing="14" MaxWidth="640">
                <TextBlock Text="Extract" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Files are copied to a folder you choose. The source image is not modified." Foreground="{StaticResource ElText2Brush}" TextWrapping="Wrap"/>
                <TextBlock Text="Destination" Foreground="{StaticResource ElTextMutedBrush}"/>
                <Grid ColumnDefinitions="*,Auto">
                  <Border Background="{StaticResource ElCharcoal800Brush}" CornerRadius="14" Padding="12,0" Height="44">
                    <TextBox Classes="plain" Text="{Binding ExtractDirectory}"/>
                  </Border>
                  <Button Grid.Column="1" Classes="el-secondary" Content="Browse" Margin="8,0,0,0" Click="OnBrowseExtract"/>
                </Grid>
                <CheckBox Content="Skip files that already match" IsChecked="{Binding SkipExisting}"/>
                <CheckBox Content="Include protected paths, copied unchanged" IsChecked="{Binding IncludeProtected}"/>
                <TextBlock Text="Pattern" Foreground="{StaticResource ElTextMutedBrush}"/>
                <Border Background="{StaticResource ElCharcoal800Brush}" CornerRadius="14" Padding="12,0" Height="44">
                  <TextBox Classes="plain" Text="{Binding Pattern}" Watermark="*.png"/>
                </Border>
                <TextBlock Text="{Binding ProtectedSummary}" TextWrapping="Wrap" Foreground="{StaticResource ElText2Brush}"/>
                <TextBlock Text="{Binding ExtractStatus}" TextWrapping="Wrap"/>
                <Button Classes="el-primary" Content="Extract all" HorizontalAlignment="Left" Command="{Binding BeginExtractAllCommand}" IsEnabled="{Binding HasImage}"/>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsVerify}">
              <StackPanel Spacing="14" MaxWidth="720">
                <TextBlock Text="Verify" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="SHA-256 is the default. SHA-1 and MD5 are optional because some archival lists still use them."
                           Foreground="{StaticResource ElText2Brush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedPath}" Classes="mono" TextWrapping="Wrap"/>
                <Button Classes="el-primary" Content="Compute SHA-256" HorizontalAlignment="Left" Command="{Binding VerifyCommand}"/>
                <Button Background="Transparent" Padding="0" HorizontalAlignment="Left" Click="OnCopyHash">
                  <TextBlock Classes="mono" Text="{Binding HashDisplay}" FontSize="13" TextWrapping="Wrap"/>
                </Button>
                <TextBlock Text="{Binding Sha1Full}" Classes="mono" IsVisible="{Binding HashSha1}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Md5Full}" Classes="mono" IsVisible="{Binding HashMd5}" TextWrapping="Wrap"/>
                <Button Classes="el-secondary" Content="Save manifest" HorizontalAlignment="Left" Click="OnSaveManifest"/>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsSettings}">
              <StackPanel Spacing="16" MaxWidth="640">
                <TextBlock Text="Settings" FontSize="22" FontWeight="Bold"/>
                <CheckBox Content="Reduce effects" IsChecked="{Binding ReduceEffects}"/>
                <CheckBox Content="Show system-update folders" IsChecked="{Binding ShowSystemUpdate}"/>
                <CheckBox Content="Also compute SHA-1" IsChecked="{Binding HashSha1}"/>
                <CheckBox Content="Also compute MD5" IsChecked="{Binding HashMd5}"/>
                <TextBlock Text="Updates" FontSize="17" FontWeight="Bold" Margin="0,8,0,0"/>
                <CheckBox Content="Check for updates on startup" IsChecked="{Binding CheckUpdatesOnStartup}"/>
                <TextBlock Text="Channel" Foreground="{StaticResource ElTextMutedBrush}"/>
                <ComboBox SelectedIndex="{Binding UpdateChannelIndex, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="200">
                  <ComboBoxItem Content="Stable"/>
                  <ComboBoxItem Content="Prerelease"/>
                </ComboBox>
                <TextBlock Text="Update source" Foreground="{StaticResource ElTextMutedBrush}"/>
                <TextBlock Text="Leave this blank. Discfolio then uses the public GitHub releases, and no token is required."
                           Foreground="{StaticResource ElText2Brush}" TextWrapping="Wrap"/>
                <Border Background="{StaticResource ElCharcoal800Brush}" CornerRadius="14" Padding="12,0" Height="44">
                  <TextBox Classes="plain" Text="{Binding UpdateSource}" Watermark="https://github.com/EliteLevelSoftware/EliteLevelDiscfolio"/>
                </Border>
                <Button Classes="el-primary" Content="Check now" HorizontalAlignment="Left" Command="{Binding CheckForUpdatesNowCommand}"/>
                <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Foreground="{StaticResource ElText2Brush}"/>
                <TextBlock Text="Default extract folder" Foreground="{StaticResource ElTextMutedBrush}"/>
                <Border Background="{StaticResource ElCharcoal800Brush}" CornerRadius="14" Padding="12,0" Height="44">
                  <TextBox Classes="plain" Text="{Binding ExtractDirectory}"/>
                </Border>
                <Border Background="{StaticResource ElCharcoal850Brush}" CornerRadius="18" Padding="16" Margin="0,12,0,0">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Elite Level" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="A product of Elite Level" Foreground="{StaticResource ElTextMutedBrush}" FontSize="12.5"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsHelp}">
              <StackPanel Spacing="12" MaxWidth="680">
                <controls:ProductMark Width="64" Height="64" HorizontalAlignment="Left"/>
                <TextBlock Text="EliteLevel Discfolio" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="{Binding VersionText}" Classes="mono" Foreground="{StaticResource ElTextMutedBrush}"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ElText2Brush}"
                           Text="Discfolio browses disc images and folder dumps you already have. It is read-only: the source is never modified. It does not include encryption keys or game data. Use it only with copies you are allowed to possess."/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ElText2Brush}"
                           Text="Open an ISO 9660 or Joliet image, an Xbox or Xbox 360 XDVDFS image, or a folder. Nintendo Switch images are not supported yet. Search by name, copy a SHA-256 hash, and extract files to a folder you choose. Protected paths, including a hidden system-update folder, are skipped unless you include them, and even then they are copied unchanged."/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ElText2Brush}"
                           Text="Right-click a library tile to remove it. That deletes the entry and its cached art only. The image file stays where it is. Clear missing drops entries whose files are gone."/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ElText2Brush}"
                           Text="Settings can check the public GitHub releases for an update. An available update downloads in the background and is installed only after you choose OK."/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ElTextMutedBrush}"
                           Text="PlayStation, Xbox and Nintendo are trademarks of their owners. Elite Level Software is not affiliated with them."/>
                <TextBlock Text="A product of Elite Level" Foreground="{StaticResource ElTextMutedBrush}"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" ZIndex="5">
        <Button Classes="el-caption" Click="OnMinimize" ToolTip.Tip="Minimise">
          <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" StrokeLineCap="Round" Width="12" Height="12" Stretch="Uniform" Data="M2,8 H12"/>
        </Button>
        <Button Classes="el-caption" Click="OnMaximize" ToolTip.Tip="Maximise">
          <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" Width="11" Height="11" Stretch="Uniform" Data="M3,3 H11 V11 H3 Z"/>
        </Button>
        <Button x:Name="CloseButton" Classes="el-caption el-close round" Click="OnClose" ToolTip.Tip="Close">
          <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" StrokeLineCap="Round" Width="12" Height="12" Stretch="Uniform" Data="M3,3 L11,11 M11,3 L3,11"/>
        </Button>
      </StackPanel>

      <Border Height="6" VerticalAlignment="Top" Margin="0,0,150,0" Background="Transparent" PointerPressed="OnResizeTop"/>
      <Border Height="6" VerticalAlignment="Bottom" Background="Transparent" PointerPressed="OnResizeBottom"/>
      <Border Width="6" HorizontalAlignment="Left" Background="Transparent" PointerPressed="OnResizeLeft"/>
      <Border Width="6" HorizontalAlignment="Right" Margin="0,34,0,0" Background="Transparent" PointerPressed="OnResizeRight"/>

      <Border IsVisible="{Binding UpdateAvailable}" ZIndex="15" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,36,36" MaxWidth="420" Padding="22" CornerRadius="22"
              Background="{StaticResource ElCharcoal850Brush}" BorderBrush="{StaticResource ElGoldBrush}" BorderThickness="1">
        <StackPanel Spacing="10">
          <TextBlock Text="Update available" FontSize="17" FontWeight="Bold"/>
          <TextBlock Text="{Binding UpdateMessage}" TextWrapping="Wrap" Foreground="{StaticResource ElText2Brush}"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="el-primary" Content="OK" Command="{Binding RestartToUpdateCommand}" IsVisible="{Binding UpdateReady}"/>
            <Button Classes="el-secondary" Content="Not now" Command="{Binding DismissUpdateCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Panel IsVisible="{Binding ShowWelcome}" ZIndex="20" Background="{StaticResource ElScrimBrush}">
        <Border Background="{StaticResource ElCharcoal850Brush}" CornerRadius="24" Padding="28" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="14">
            <TextBlock Text="Read-only, on your copies" FontSize="22" FontWeight="Bold"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ElText2Brush}"
                       Text="EliteLevel Discfolio browses disc images and folder dumps you already have. It does not modify the source, and it does not include encryption keys or game data. Use it only with copies you are allowed to possess."/>
            <Button Classes="el-primary" Content="Continue" HorizontalAlignment="Left" Command="{Binding DismissWelcomeCommand}"/>
          </StackPanel>
        </Border>
      </Panel>

      <Panel IsVisible="{Binding ShowExtractDialog}" ZIndex="20" Background="{StaticResource ElScrimBrush}">
        <Border Background="{StaticResource ElCharcoal850Brush}" CornerRadius="24" Padding="28" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="12">
            <TextBlock Text="Extract files" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="{Binding ProtectedSummary}" TextWrapping="Wrap" Foreground="{StaticResource ElText2Brush}"/>
            <TextBlock Text="Destination" Foreground="{StaticResource ElTextMutedBrush}"/>
            <Grid ColumnDefinitions="*,Auto">
              <Border Background="{StaticResource ElCharcoal800Brush}" CornerRadius="14" Padding="12,0" Height="44">
                <TextBox Classes="plain" Text="{Binding ExtractDirectory}"/>
              </Border>
              <Button Grid.Column="1" Classes="el-secondary" Content="Browse" Margin="8,0,0,0" Click="OnBrowseExtract"/>
            </Grid>
            <CheckBox Content="Skip files that already match" IsChecked="{Binding SkipExisting}"/>
            <CheckBox Content="Include protected paths, copied unchanged" IsChecked="{Binding IncludeProtected}"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Classes="el-primary" Content="Extract" Command="{Binding ConfirmExtractCommand}"/>
              <Button Classes="el-secondary" Content="Cancel" Command="{Binding CancelExtractCommand}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Panel>
    </Grid>
  </Border>
</controls:EliteWindow>
