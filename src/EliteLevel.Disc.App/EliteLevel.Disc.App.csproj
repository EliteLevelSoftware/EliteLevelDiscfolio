<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Discfolio</AssemblyName>
    <RootNamespace>EliteLevel.Disc.App</RootNamespace>
    <ApplicationTitle>EliteLevel Discfolio</ApplicationTitle>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Description>Read-only explorer for console disc images and folder dumps.</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EliteLevel.Avalonia\EliteLevel.Avalonia.csproj" />
    <ProjectReference Include="..\EliteLevel.Disc.Core\EliteLevel.Disc.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**\*" />
  </ItemGroup>
</Project>
