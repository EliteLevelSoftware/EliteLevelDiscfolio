<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EliteLevel.Avalonia.Controls.ProductMark"
             Width="30" Height="30">
  <Grid>
    <Ellipse Stroke="{StaticResource ElGoldBrush}" StrokeThickness="1.6" Margin="1"/>
    <Ellipse Fill="{StaticResource ElOxblood500Brush}" Margin="6"/>
    <Ellipse Fill="{StaticResource ElGoldWarmBrush}" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
    <Ellipse Fill="{StaticResource ElCharcoal900Brush}" Width="4" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Grid>
</UserControl>
