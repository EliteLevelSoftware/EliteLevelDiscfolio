<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EliteLevel.Avalonia.Controls.SeamMark"
             Width="28" Height="28">
  <!-- Seam house mark. Weights are the 24–40px band so the join stays visible at the About size. -->
  <Viewbox Stretch="Uniform">
    <Panel Width="100" Height="100">
      <Panel.Clip>
        <RectangleGeometry Rect="4,4,92,92" RadiusX="8" RadiusY="8"/>
      </Panel.Clip>
      <Path Fill="{StaticResource ElOxblood500Brush}"
            Data="M0,0 L48,0 L56,18 L44,34 L52,52 L38,70 L46,86 L40,100 L0,100 Z"/>
      <Path Fill="{StaticResource ElOxblood900Brush}"
            Data="M48,0 L100,0 L100,100 L40,100 L46,86 L38,70 L52,52 L44,34 L56,18 Z"/>
      <Path Stroke="#E0C77E" StrokeThickness="5.6" StrokeJoin="Miter"
            Data="M48,0 L56,18 L44,34 L52,52 L38,70 L46,86 L40,100"/>
      <Path Stroke="#E0C77E" StrokeThickness="4.4" StrokeLineCap="Round"
            Data="M44,34 L28,43"/>
      <Path Stroke="#E0C77E" StrokeThickness="4.2" StrokeLineCap="Round"
            Data="M52,52 L69,61"/>
      <Path Stroke="#E0C77E" StrokeThickness="4" StrokeLineCap="Round"
            Data="M38,70 L25,75"/>
    </Panel>
  </Viewbox>
</UserControl>
