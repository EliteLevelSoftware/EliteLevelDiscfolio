<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EliteLevel.Avalonia.Controls.HeroCard">
  <Grid>
    <Border CornerRadius="26" BoxShadow="{StaticResource ElShadowHeroGlow}" Background="Transparent"/>
    <Border CornerRadius="26" ClipToBounds="True" Background="{StaticResource ElCharcoal950Brush}">
      <Grid>
        <Image x:Name="ArtImage" Stretch="UniformToFill"/>
        <Border Background="{StaticResource ElGradVignette}" IsHitTestVisible="False"/>
        <Border Background="{StaticResource ElGradHeroScrim}" IsHitTestVisible="False"/>
        <Border Background="{StaticResource ElGrainBrush}" IsHitTestVisible="False"/>
        <Grid Margin="28,22,28,26" RowDefinitions="Auto,*,Auto">
          <StackPanel x:Name="ChipPanel" Orientation="Horizontal" Spacing="8"/>
          <StackPanel Grid.Row="2" Spacing="14">
            <TextBlock x:Name="EyebrowText" Foreground="{StaticResource ElGoldEyebrowBrush}" FontSize="12.5" FontWeight="SemiBold"/>
            <TextBlock x:Name="TitleText" Foreground="{StaticResource ElTextStrongBrush}" FontSize="48" FontWeight="ExtraBold"
                       LetterSpacing="-1.6" LineHeight="46" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
            <StackPanel x:Name="MetaPanel" Orientation="Horizontal" Spacing="8"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
